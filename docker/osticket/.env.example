# osTicket
# Passwords are in docker-compose.yml for simplicity
# In production, move them to .env
# osTicket Application
DB_PASS=CHANGE_ME
INSTALL_SECRET=CHANGE_ME
INSTALL_EMAIL=helpdesk@example.com
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User

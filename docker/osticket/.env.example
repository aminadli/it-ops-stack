# MySQL Database
# MYSQL_PASSWORD must match DB_PASS above
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT
MYSQL_DATABASE=osticket
MYSQL_USER=osticket
MYSQL_PASSWORD=CHANGE_ME
